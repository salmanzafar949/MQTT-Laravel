{
    "name": "salmanzafar/laravel-mqtt",
    "description": "A simple Laravel Library to connect/publish/subscribe to MQTT broker",
    "type": "library",
    "version": "4.0.0",
    "license": "MIT",
    "authors": [
        {
            "name": "Salman Zafar",
            "email": "salmanzafar949@gmail.com"
        }
    ],
    "keywords": [
        "laravel",
        "laravel12",
        "laravel13",
        "laravel-12",
        "laravel-13",
        "mqtt",
        "mqtt-laravel",
        "mqtt-laravel-publisher",
        "mqtt-laravel-subscriber",
        "laravel mqtt library",
        "laravel-mqtt",
        "laravel mqtt",
        "mqtt laravel",
        "mqtt 3.1.1",
        "php-mqtt",
        "iot",
        "php",
        "php 8"
    ],
    "require": {
        "php": "^8.0",
        "php-mqtt/client": "^2.0",
        "psr/log": "^1.0 || ^2.0 || ^3.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpunit/phpunit": "^11.0 || ^12.0"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Salman\\Mqtt\\": "src/"
        },
        "files": [
            "src/Helper/Helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Salman\\Mqtt\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Salman\\Mqtt\\MqttServiceProvider"
            ],
            "aliases": {
                "Mqtt": "Salman\\Mqtt\\Facades\\Mqtt"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "lint": "pint --test",
        "lint:fix": "pint",
        "analyse": "phpstan analyse"
    }
}
