{
    "name": "salmanzafar/laravel-mqtt",
    "description": "A simple Laravel Library to connect/publish/subscribe to MQTT broker",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Salman Zafar",
            "email": "salmanzafar949@gmail.com"
        }
    ],
    "keywords": [
        "laravel",
        "laravel5",
        "laravel6",
        "laravel7",
        "laravel8",
        "laravel9",
        "laravel10",
        "laravel11",
        "laravel12",
        "laravel-5",
        "laravel-6",
        "laravel-7",
        "laravel-8",
        "laravel-9",
        "laravel-10",
        "laravel-11",
        "laravel-12",
        "mqtt-laravel",
        "mqtt-laravel-publisher",
        "mqtt-laravel-subscriber",
        "laravel mqtt library",
        "laravel-mqtt",
        "laravel mqtt",
        "mqtt laravel",
        "php",
        "php 7.4",
        "php 8",
        "php 8.1",
        "php 8.2",
        "php 8.3",
        "php 8.4"
    ],
    "require": {
        "php": "^7.2 || ^8.0"
    },
    "require-dev": {
        "laravel/framework": "^5.5 || ^6.0 || ^7.0 || ^8.0 || ^9.0 || ^10.0 || ^11.0 || ^12.0",
        "orchestra/testbench": "^3.5 || ^4.0 || ^5.0 || ^6.0 || ^7.0 || ^8.0 || ^9.0 || ^10.0",
        "phpunit/phpunit": "^7.0 || ^8.0 || ^9.0 || ^10.0 || ^11.0"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Salman\\Mqtt\\": "src/"
        },
        "files": [
            "src/Helper/Helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Salman\\Mqtt\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Salman\\Mqtt\\MqttServiceProvider"
            ],
            "aliases": {
                "Mqtt": "Salman\\Mqtt\\Facades\\Mqtt"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit"
    }
}
